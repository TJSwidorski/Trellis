node_modules/
.worktrees/
.trellis/state.json
.trellis/run.jsonl
.trellis/REPORT.md
.trellis/ledger.jsonl

# Regenerated by the runner as worktrees come and go — do not commit it,
# or the next run will refuse to start on a dirty tree.
trellis.code-workspace

# A/B harness output — two full scratch repos plus the report. Regenerated by
# every run; committing it would put a whole Trellis install inside this one.
.bench/

# Materialised view of SKILLS/skills, rewritten by the driver between stages.
# SKILLS/ is the committed source of truth. Tracking this would leave the tree
# dirty after every stage transition, and the runner refuses to start dirty.
.claude/skills/
.env
.env.*
