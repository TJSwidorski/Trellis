node_modules/
.worktrees/
.trellis/state.json
.trellis/run.jsonl
.trellis/REPORT.md
.trellis/ledger.jsonl
# Operational telemetry, same bucket as ledger.jsonl — measured, not a
# deliverable a human reviews. Written by every stage (recordSession), not
# just one, so no single stage's `commits` list is the right place for it.
.trellis/sessions.jsonl

# Written by code (not by a session, so nothing else is responsible for
# committing it) at a point that precedes the runner's dirty-tree check —
# leaving either untracked would make the very next `run`/`run --resume`
# refuse to start on a tree it just made dirty itself.
.trellis/cycle.json
.trellis/checkpoint.json
.trellis/handback.json

# 01_ingest's own working state, not a deliverable — nothing downstream reads
# either back once ingest.json's zero-error check has passed, and no doc asks
# an operator to commit them by hand. Left untracked, these silently halted
# `trellis auto` on the very first stage of a fresh project: 01_ingest commits
# nothing, so any modified/untracked file at that point reads as "unexpected".
.trellis/ingest.json
.trellis/product-graph.derived.json

# Regenerated on every `trellis watch` render — a static snapshot of the level
# view, not a deliverable. Untracked so it cannot leave the tree dirty for the
# runner's start-up check.
.trellis/watch.html

# Regenerated by the runner as worktrees come and go — do not commit it,
# or the next run will refuse to start on a dirty tree.
trellis.code-workspace

# A/B harness output — two full scratch repos plus the report. Regenerated by
# every run; committing it would put a whole Trellis install inside this one.
.bench/

# Materialised view of SKILLS/skills, rewritten by the driver between stages.
# SKILLS/ is the committed source of truth. Tracking this would leave the tree
# dirty after every stage transition, and the runner refuses to start dirty.
.claude/skills/
.env
.env.*
